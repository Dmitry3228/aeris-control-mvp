# Optional host-port overrides. Internal service ports stay fixed.
AERIS_WEB_PORT=3100
AERIS_API_PORT=4100
AERIS_CLICKHOUSE_PORT=8124

# Local-only ClickHouse credentials used by the API and test tooling.
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=aeris-local

# Runtime truthfulness, query, and ingestion safety limits.
AERIS_STALE_AFTER_SECONDS=30
AERIS_HISTORY_MAX_SPAN_DAYS=7
AERIS_HISTORY_POINT_BUDGET=600
AERIS_TELEMETRY_MAX_PAST_AGE_SECONDS=604800
AERIS_TELEMETRY_MAX_FUTURE_SKEW_SECONDS=30
